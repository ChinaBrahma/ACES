FROM node:22-alpine

# Install minimal runtime dependencies
RUN apk add --no-cache \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    libstdc++ \
    udev \
    dbus \
    glib \
    fontconfig \
    && rm -rf /var/cache/apk/*

WORKDIR /app

# Copy package files
COPY package*.json ./

# ⚠️ Do NOT skip Chromium download
# (remove PUPPETEER_SKIP_CHROMIUM_DOWNLOAD)
RUN npm ci --omit=dev

# Copy app code
COPY . .

# Drop privileges
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

EXPOSE 5001
CMD ["node", "server.js"]
